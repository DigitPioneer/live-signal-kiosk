[Unit]
Description=LiveSignal Kiosk
Conflicts=getty@tty1.service
After=getty@tty1.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__KIOSK_USER__
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
ExecStart=__APP_DIR__/scripts/start-kiosk.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
