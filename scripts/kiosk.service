[Unit]
Description=LiveSignal Kiosk
Conflicts=getty@tty1.service
After=getty@tty1.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__KIOSK_USER__
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
ExecStart=__APP_DIR__/scripts/start-kiosk.sh
Restart=always
RestartSec=3

# /run/live-signal-kiosk, owned by __KIOSK_USER__ - holds the watcher's
# pidfile (read by scripts/toggle-admin-mode.sh to send SIGUSR1) and the
# exit-admin sentinel file the local admin editor writes. Created fresh by
# systemd before each start and removed after stop.
RuntimeDirectory=live-signal-kiosk
RuntimeDirectoryMode=0750

[Install]
# Raspberry Pi OS Lite (and generic Debian/Ubuntu server installs) boot to
# multi-user.target - there's no display manager, so graphical.target is
# never reached and a unit WantedBy=graphical.target would never actually
# start on a cold boot (it would only ever run if started manually, e.g.
# `systemctl start kiosk`, which can make the bug look fixed when it isn't -
# see docs/troubleshooting.md's cold-boot testing note).
WantedBy=multi-user.target
