# LiveSignal Kiosk configuration
#
# Installed to /etc/live-signal-kiosk/config.env by install.sh on first install
# only. install.sh and update.sh will NEVER overwrite that file on re-run, so
# your edits persist across updates. Edit the installed copy, not this one.

# YouTube channel "live" page to poll. Use the channel's /live URL (works for
# both @handle and legacy /channel/UC... style channels).
CHANNEL_LIVE_URL="https://www.youtube.com/@SRCMinistry/live"

# How often (seconds) to check whether the channel is live.
CHECK_INTERVAL_SECONDS=30

# Consecutive "not live" checks required before switching from LIVE back to
# WAITING. Going TO live is immediate on the first "is_live" result. This
# only debounces the return trip, to avoid flapping on a single dropped check.
OFFLINE_CONFIRM_CHECKS=2

# Query params documented here for reference / for anyone wiring up a
# Chromium-embed fallback later. Not used by mpv, which plays the resolved
# stream URL directly.
YOUTUBE_EMBED_PARAMS="autoplay=1&controls=1&rel=0&modestbranding=1"

# Port the watcher's local HTTP server binds to (127.0.0.1 only).
LOCAL_SERVER_PORT=8765

# Leave blank to auto-detect (tries chromium-browser, then chromium).
CHROMIUM_BIN=""

# Leave blank to auto-detect (mpv on PATH).
MPV_BIN=""

# Leave blank to auto-detect (yt-dlp on PATH, else /usr/local/bin/yt-dlp).
YTDLP_BIN=""

# System user the kiosk session runs as.
KIOSK_USER="kiosk"

# Python logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL="INFO"

# --- Optional slide editor (kiosk-editor.service, off by default) ----------
#
# Small LAN-reachable web UI for editing slides.json and uploading images
# without SSH. Protected with HTTP Basic Auth. Not started automatically by
# install.sh - see README for how to turn it on. CHANGE EDITOR_PASSWORD
# from the default before enabling this on your network.

# Port the editor binds to on the device's LAN interface (not 127.0.0.1).
EDITOR_PORT=8766

EDITOR_USERNAME="admin"
EDITOR_PASSWORD="changeme"

# --- Local admin breakout (physical keyboard on the device only) -----------
#
# Ctrl+Alt+Escape on a keyboard attached directly to the device toggles a
# local-only instance of the editor (same login as above), reachable ONLY
# at http://127.0.0.1:<this port> from a windowed browser on the device
# itself - never over the network, regardless of this setting. Separate
# port from EDITOR_PORT so both can run at once without conflicting.
LOCAL_ADMIN_PORT=8767
